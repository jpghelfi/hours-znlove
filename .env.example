# --- Notion integration (data access) ---
# Internal integration secret, starts with "ntn_". Create at
# https://www.notion.so/my-integrations
NOTION_TOKEN=

# The Notion page the databases live under (URL or 32-char id). Only needed to
# run src/setup_databases.py; not needed by the web app.
NOTION_PARENT_PAGE=

# Database/data-source ids. Written to databases.json by setup_databases.py for
# local use. On a deploy host (no file), set these instead:
# PROJECTS_DS_ID=
# TIME_ENTRIES_DS_ID=
# PROJECTS_DB_ID=
# TIME_ENTRIES_DB_ID=

# --- Web app: Notion OAuth login ---
# Make the integration "public" (Distribution tab) to get these, and set the
# redirect URI to  https://<your-host>/auth/callback
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=

# Access is curated in the People db (Active row = can log in, Admin checkbox =
# team-wide reports). These env lists are a FALLBACK, OR'd on top of the roster
# so a People-db misconfig can't lock everyone out. Keep your own email in
# ADMIN_EMAILS as a break-glass admin. Comma-separated.
ALLOWED_EMAILS=you@znlove.xyz, teammate@znlove.xyz
ADMIN_EMAILS=you@znlove.xyz

# Random secret for signing session cookies (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`)
SESSION_SECRET=

# Local dev only: set to 1 to bypass login. NEVER set in production.
# AUTH_DISABLED=1

# ---- project budgets ----
# Threshold emails when a project nears or passes its monthly budget. Off by
# default and separate from the GOOGLE_* credentials above, which also serve
# the Sheets export — connecting Google must not switch this on by itself.
# /budgets, the cap and the log-form meter all work with this off.
#BUDGET_ALERTS_ENABLED=1
#BUDGET_ALERT_TO=zarco@znlove.xyz          # falls back to REPORT_TO
#BUDGET_WARN_PCT=95                        # used when a project's "Warn at %" is blank

# ---- partner umbrellas ----
# Options seeded onto the Projects db's `Partner` column the first time it is
# created (see docs/partners.md). Only ever read when that column doesn't exist
# yet — after that Notion's own option list is the source of truth, and partners
# are edited on /assignments or in Notion.
#PARTNERS=Bear,Telus
